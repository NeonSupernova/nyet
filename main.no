;;;; Nyet Language Reference
;;;; This file is valid Nyet source. It compiles.
;;;; Comments are the specification. Code is the proof.
;;;;
;;;; Nyet: S-expression syntax, static types, Rust-inspired ownership,
;;;; extensible IO channels, first-class functions, and operator overloading.
;;;;
;;;; The first element of any parenthetical is a callable — a function,
;;;; operator, type constructor, array, or any value that implements call semantics.
;;;; There is no special syntax. Everything is an expression.


;; ============================================================
;;; Comment System
;; ============================================================

;;; Nyet has four comment tiers. The autodoc system maps each tier to
;;; a documentation level. Write the tier that matches your intent.

;;;;  file-level    — describes the file or module (this file header)
;;;   section       — describes a logical section of the file
;;    block         — describes a declaration or a few lines
;     inline        — notes on a single expression


;; ============================================================
;;; Primitives
;; ============================================================

;;; The eight primitive types. All are value types.

(let a:i32    42)            ; 32-bit signed integer
(let b:i64    1000000000)    ; 64-bit signed integer
(let c:f32    3.14)          ; 32-bit float
(let d:f64    2.718281828)   ; 64-bit float
(let e:bool   true)          ; true or false
(let f:string "hello")       ; owned UTF-8 string
(let g:unit   ())            ; the absence of a value

;;; Type annotations can be omitted when the compiler can infer them.
;;; Be explicit at function boundaries. Be implicit inside expressions.

(let x 42)          ; inferred i32
(let y 3.14)        ; inferred f64
(let z "hello")     ; inferred string


;; ============================================================
;;; Variables and Mutability
;; ============================================================

;;; let declares an immutable binding.
;;; var declares a mutable binding.
;;; The compiler enforces this — assigning to a let binding is a compile error.

(let  name:string "Ada")    ; immutable
(var  count:i32   0)        ; mutable

;;; = assigns to any valid l-value. The binding must be var.

(= count 1)                 ; ok
; (= name "Bob")            ; compile error — name is let

;;; = works uniformly on variables, indexed positions, and nested fields.

(var scores:Array[i32] [10 20 30])
(= (scores 0) 99)                       ; indexed assignment

(var p:Person (Person name:"Ada" age:36))
(= (. p name) "Grace")                  ; field assignment
(= (. p address city) "London")         ; deep field assignment


;; ============================================================
;;; Ownership and Borrowing
;; ============================================================

;;; Every value has exactly one owner.
;;; When the owner goes out of scope the value is dropped.
;;; Values can be borrowed without transferring ownership.
;;;
;;; In type position:
;;;   T    — owned, value is moved into the function
;;;   &T   — immutable borrow, caller retains ownership
;;;   &!T  — mutable borrow, caller retains ownership, function may mutate

(fn read_val  (x:&i32)  -> i32  x)          ; borrows x, does not consume it
(fn consume   (x:i32)   -> i32  x)          ; takes ownership of x

;;; After consume(v), v is no longer valid in the caller.
;;; The compiler enforces this at compile time — no runtime cost.


;; ============================================================
;;; Functions
;; ============================================================

;;; fn declares a named function.
;;; Parameters are listed with name:type. Return type follows ->.
;;; The function body is a single expression whose value is returned.

(fn add (x:i32 y:i32) -> i32
  (+ x y))

(fn square (x:f64) -> f64
  (* x x))

;;; For multiple expressions in a body, use do.
;;; do evaluates each expression in order and returns the last.

(fn greet (name:string) -> string
  (do
    (let msg:string (+ "hello, " name))
    msg))

;;; Anonymous functions — fn with no name is a value.
;;; Bind it, pass it, return it.

(let double (fn (x:i32) -> i32 (* x 2)))

;;; Functions are first-class. The type of a function is written (fn Args -> Ret).

(fn apply (f:(fn i32 -> i32) x:i32) -> i32
  (f x))

(apply double 5)     ; 10

;;; Return a function from a function.

(fn make_adder (n:i32) -> (fn i32 -> i32)
  (fn (x:i32) -> i32 (+ x n)))

(let add5 (make_adder 5))
(add5 3)    ; 8

;;; Recursive functions are declared the same way — fn is in scope in its own body.

(fn factorial (n:i32) -> i32
  (if (<= n 1) 1 (* n (factorial (- n 1)))))


;; ============================================================
;;; Operators
;; ============================================================

;;; Every operator is a function dispatched on its argument types.
;;; (+ a b) calls the + function. On i32 it adds integers.
;;; On string it concatenates. On a user type it calls your implementation.
;;; Operators live in the same namespace as functions. There is no special case.

;; Arithmetic — defined on i32 i64 f32 f64
(+ 1 2)        ; 3
(- 10 3)       ; 7
(* 4 5)        ; 20
(/ 10 2)       ; 5  — numeric division on numbers

;; String concatenation — + on strings
(+ "hello" ", " "world")    ; "hello, world"

;; Path construction — / on strings builds a filesystem or IO path
(/ "usr" "local" "bin")          ; /usr/local/bin
(/ "home" "ada" ".config")       ; /home/ada/.config

;; Comparison — return bool
(== 1 1)    ; true
(!= 1 2)    ; true
(<  1 2)    ; true
(<= 2 2)    ; true
(>  3 2)    ; true
(>= 3 3)    ; true

;; Logical
(&& true false)    ; false
(|| true false)    ; true
(!  true)          ; false

;; Field access — . is variadic, walks a path through nested fields
(. person name)                  ; person.name
(. person address city)          ; person.address.city
(. company ceo address zip)      ; deep path, no nesting required

;; Pipe — |> threads a value through a chain of functions
;; (|> v f g h) is equivalent to (h (g (f v)))
(|> [1 2 3 4 5]
  (map    (fn (x:i32) -> i32  (* x 2)))
  (filter (fn (x:i32) -> bool (> x 4)))
  (fold   + 0))                  ; 24

;; Error propagation — ? unwraps Ok or returns Err immediately
;; The enclosing function must return a compatible Result type
(let val:f64 (? (divide 10.0 2.0)))


;; ============================================================
;;; Control Flow
;; ============================================================

;;; All control flow is an expression — it returns a value.
;;; Both branches of if must return the same type.

(if (== x 0) "zero" "nonzero")

;;; Bind the result of if.

(let label:string
  (if (> score 90) "pass" "fail"))

;;; pass is the unit no-op — use it when a branch has no meaningful value.

(if loud (out "loud!") pass)

;;; match — pattern matches on sum type variants, literals, and wildcards.
;;; All arms must return the same type.

(match shape
  ((Circle r)   (* 3.14159 r r))
  ((Rect w h)   (* w h))
  (Point        0.0))

;;; Wildcard arm with _

(match x
  (0  "zero")
  (1  "one")
  (_  "other"))

;;; match on Result is the primary error-handling pattern.

(match (divide 10.0 0.0)
  ((Ok  v) (out v))
  ((Err e) (err "division failed")))

;;; Loops — use recursion or collection functions for iteration.
;;; loop runs a body until an explicit break. break is an expression
;;; that carries a return value out of the loop.

(var i:i32 0)
(loop
  (if (>= i 5)
    (break i)
    (do
      (out i)
      (= i (+ i 1)))))


;; ============================================================
;;; Structs
;; ============================================================

;;; struct declares a named product type with named fields.

(struct Point2
  x:f64
  y:f64)

(struct Address
  street:string
  city:string
  zip:string)

(struct Person
  name:string
  age:i32
  address:Address)

;;; Construct with named arguments.

(let origin:Point2  (Point2 x:0.0 y:0.0))
(let home:Address   (Address street:"1 Loop Rd" city:"London" zip:"EC1"))
(let me:Person      (Person name:"Ada" age:36 address:home))

;;; Field access with .

(. me name)               ; "Ada"
(. me address city)       ; "London"


;; ============================================================
;;; Sum Types
;; ============================================================

;;; type declares a tagged union. Each variant may carry fields.
;;; Unit variants carry no data.

(type Direction (North) (South) (East) (West))

(type Shape
  (Circle  r:f64)
  (Rect    w:f64 h:f64)
  (Point))

(type Tree[T]
  (Leaf  value:T)
  (Node  left:Tree[T] right:Tree[T]))

;;; Construct a variant by name.

(let s:Shape   (Circle r:5.0))
(let d:Direction North)
(let t:Tree[i32] (Node
                   left:(Leaf value:1)
                   right:(Leaf value:2)))

;;; Destructure variants in match.

(fn area (s:Shape) -> f64
  (match s
    ((Circle r)   (* 3.14159 r r))
    ((Rect w h)   (* w h))
    (Point        0.0)))


;; ============================================================
;;; Generics
;; ============================================================

;;; Generic types use square brackets for type parameters.
;;; Type parameters are uppercase by convention.

(type Option[T]
  (Some value:T)
  (None))

(type Result[T E]
  (Ok  value:T)
  (Err error:E))

(type Pair[A B]
  (first:A second:B))

;;; Generic functions declare type parameters in brackets after fn name.

(fn identity[T] (x:T) -> T  x)
(fn first[A B]  (p:Pair[A B]) -> A  (. p first))

;;; Built-in generic containers.
;;;   Array[T]    — ordered, indexable, growable
;;;   Map[K V]    — key-value store
;;;   Set[T]      — unique unordered values


;; ============================================================
;;; Error Handling
;; ============================================================

;;; Fallible functions return Result[T E].
;;; This is the required convention for any function that can fail.
;;; Callers must handle both arms — the compiler will not let an Err go unmatched.

(type MathError
  (DivisionByZero)
  (Overflow))

(fn divide (a:f64 b:f64) -> Result[f64 MathError]
  (if (== b 0.0)
    (Err DivisionByZero)
    (Ok (/ a b))))

;;; ? propagates Err upward. If the value is Err, the enclosing function
;;; immediately returns that Err. The enclosing function must return
;;; a compatible Result type. If the value is Ok, ? unwraps it.

(fn calc (x:f64) -> Result[f64 MathError]
  (let half:f64 (? (divide x 2.0)))
  (Ok (* half half)))

;;; Functions with no meaningful success value return Result[() E].
;;; (Ok ()) is the unit success.

(type IOError
  (NotFound)
  (PermissionDenied)
  (Disconnected))

(fn log (msg:string) -> Result[() IOError]
  (out msg)
  (Ok ()))

;;; Chain fallible calls with ? and |>.

(fn pipeline (x:f64) -> Result[f64 MathError]
  (|> (Ok x)
    (? (divide 100.0))
    (? (divide 2.0))))


;; ============================================================
;;; Collections
;; ============================================================

;;; Array literals use square brackets.

(let nums:Array[i32]        [1 2 3 4 5])
(let words:Array[string]    ["one" "two" "three"])
(let grid:Array[Array[i32]] [[1 2 3] [4 5 6]])

;;; Arrays are callable — (arr index) returns the element at that index.
;;; This is not a special case. Arrays implement call semantics like any value.

(nums 0)       ; 1
(nums 4)       ; 5
(grid 1)       ; [4 5 6]
((grid 1) 2)   ; 6 — nested index

;;; Mutable indexed assignment.

(var scores:Array[i32] [10 20 30])
(= (scores 1) 99)     ; scores is now [10 99 30]

;;; Higher-order functions on collections.

(map    (fn (x:i32) -> i32  (* x 2))            nums)   ; [2 4 6 8 10]
(filter (fn (x:i32) -> bool (> x 3))            nums)   ; [4 5]
(fold   (fn (acc:i32 x:i32) -> i32 (+ acc x)) 0 nums)   ; 15
(any    (fn (x:i32) -> bool (== x 3))           nums)   ; true
(all    (fn (x:i32) -> bool (> x 0))            nums)   ; true

;;; Chained with pipe.

(|> nums
  (filter (fn (x) (> x 2)))
  (map    (fn (x) (* x x)))
  (fold   + 0))              ; 50


;; ============================================================
;;; Operator Overloading
;; ============================================================

;;; impl binds function implementations to a type.
;;; Define any function name — including operator symbols — inside impl.
;;; When that operator is called with your type as an argument, your
;;; implementation is dispatched. This is how + works on strings.
;;; It is how you make your types feel native to the language.

(struct Vec2
  x:f64
  y:f64)

(impl Vec2
  ;; addition
  (fn + (self:Vec2 other:Vec2) -> Vec2
    (Vec2 x:(+ (. self x) (. other x))
          y:(+ (. self y) (. other y))))

  ;; scalar multiplication
  (fn * (self:Vec2 scalar:f64) -> Vec2
    (Vec2 x:(* (. self x) scalar)
          y:(* (. self y) scalar)))

  ;; equality
  (fn == (self:Vec2 other:Vec2) -> bool
    (&& (== (. self x) (. other x))
        (== (. self y) (. other y))))

  ;; length as a method — not an operator, just a function on Vec2
  (fn len (self:&Vec2) -> f64
    (let sum (+ (* (. self x) (. self x))
                (* (. self y) (. self y))))
    (sqrt sum)))

(let a:Vec2 (Vec2 x:1.0 y:2.0))
(let b:Vec2 (Vec2 x:3.0 y:4.0))

(+ a b)       ; Vec2 x:4.0 y:6.0
(* a 2.0)     ; Vec2 x:2.0 y:4.0
(== a b)      ; false
(len a)       ; 2.236...

;;; Implement / on a type to give it path/join semantics.

(struct URL base:string)

(impl URL
  (fn / (self:URL segment:string) -> URL
    (URL base:(+ (. self base) "/" segment))))

(let api:URL (URL base:"https://api.example.com"))
(/ api "users")         ; URL base:"https://api.example.com/users"
(/ api "users" "42")    ; URL base:"https://api.example.com/users/42"


;; ============================================================
;;; IO Channels
;; ============================================================

;;; IO in Nyet is channel-based.
;;; A channel is a first-class value of type IOChannel.
;;; Channels are opened, passed to functions, composed, and closed like any value.
;;;
;;; Built-in channels:
;;;   out  — standard output (stdout)
;;;   in   — standard input  (stdin)
;;;   err  — standard error  (stderr)

;;; out with one argument writes to stdout.
(out "hello, world\n")

;;; out with two arguments writes to an explicit channel.
(out err "something went wrong\n")

;;; in with no arguments reads a line from stdin.
(let line:string (in))

;;; in from an explicit channel.
(let data:string (in myfile))

;;; io/def creates a named channel. Channels are values.

(io/def mylog    (io/file (/ "var" "log" "app.log") :append))
(io/def port13   (io/pin 13 :digital :output))
(io/def button   (io/pin 7  :digital :input))
(io/def server   (io/tcp "0.0.0.0" 8080))

;;; Path construction with / composes cleanly with IO.

(io/def conf (io/file (/ "etc" "app" "config.toml") :read))

;;; Channels are passed to functions as IOChannel values.

(fn log_to (ch:IOChannel msg:string) -> Result[() IOError]
  (out ch (+ msg "\n"))
  (Ok ()))

(? (log_to mylog "server started"))
(? (log_to err   "warning: high memory"))

;;; Write to a hardware pin.

(out port13 HIGH)
(out port13 LOW)
(let state:bool (in button))


;; ============================================================
;;; Macros
;; ============================================================

;;; Macros transform syntax at compile time.
;;; Because Nyet source is already S-expressions, macros receive and
;;; return AST nodes directly — there is no gap between code and data.
;;; quote returns an expression unevaluated, as an AST value.

(macro unless (cond body)
  (if (! cond) body pass))

(unless (== x 0)
  (out "nonzero"))

;;; Macros enable DSLs. The same IO channel infrastructure supports
;;; a web routing DSL:

(macro route (method path handler)
  (io/on server method path handler))

(route GET  (/ "users")     list_users)
(route POST (/ "users")     create_user)
(route GET  (/ "users" :id) get_user)    ; :id is a path parameter

;;; And a hardware DSL:

(macro pin/high   (p) (out p HIGH))
(macro pin/low    (p) (out p LOW))
(macro pin/toggle (p)
  (if (== (in p) HIGH)
    (pin/low  p)
    (pin/high p)))

(io/def led (io/pin 13 :digital :output))
(pin/high   led)
(pin/toggle led)

;;; A logging DSL that captures the expression source for context:

(macro log/debug (expr)
  (do
    (out err (+ "DEBUG " (quote expr) " = "))
    (let result expr)
    (out err result)
    result))

(log/debug (divide 10.0 2.0))    ; prints: DEBUG (divide 10.0 2.0) = Ok(5.0)
