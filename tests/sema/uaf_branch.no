;; Should be rejected: both branches consume `p`, so after the if it's
;; definitely moved.

(struct Person name:string age:i32)

(fn consume (p:Person) -> unit
  (out! (. p name)))

(fn main () -> unit
  (let p (Person name:"alice" age:30))
  (let cond true)
  (if cond (consume p) (consume p))
  (out! (. p name)))
