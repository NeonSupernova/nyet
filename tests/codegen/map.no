;; Map[string V] -- backed by runtime/map.c. Matches main.no's own
;; documented example: construction, lookup via call syntax, and
;; insert/update via assignment.
;; Expected:
;;   /home/ada
;;   /usr/bin
;;   xterm-256

(fn main () -> unit
  (let env:Map[string string]
    {"HOME" "/home/ada" "PATH" "/usr/bin"})
  (out! (env "HOME")) (out! "\n")
  (out! (env "PATH")) (out! "\n")
  (= (env "TERM") "xterm-256")
  (out! (env "TERM")) (out! "\n"))
