;; Tuple construction and indexing: `#(e0 e1 ...)` and `(t i)`.
;; Expected:
;;   42
;;   hello
;;   1
;;   3
;;   3
;;   4

(fn make_pair (a:i32 b:i32) -> #(i32 i32) #(a b))

(fn main () -> unit
  (let pair:#(i32 string) #(42 "hello"))
  (let triple:#(f64 f64 f64) #(1.0 2.0 3.0))
  (out (pair 0)) (out "\n")
  (out (pair 1)) (out "\n")
  (out (triple 0)) (out "\n")
  (out (triple 2)) (out "\n")
  (let s:#(i32 i32) (make_pair 3 4))
  (out (s 0)) (out "\n")
  (out (s 1)) (out "\n"))
