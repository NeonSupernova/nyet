;; Regression test: reading a struct element out of an `Array[T]` into a
;; `let` with no explicit `&T` annotation used to lose track of which
;; struct type the binding held. `_infer_nyet_type_name` had no case for
;; "a Call indexing a known array binding", so `_emit_let` took the
;; scalar-`ptr` path instead of the aggregate path and never registered
;; the binding in `_env_struct_name` -- so `(. a field)` on it silently
;; failed (no error, just wrong output) instead of loading the field.
;; Expected: 1 / 3 / 5

(struct Point x:i32 y:i32)

(fn main () -> unit
  (do
    (let pts:Array[Point] [(Point x:1 y:2) (Point x:3 y:4)])
    (let a (pts 0))
    (out (. a x)) (out "\n")
    (let b (pts 1))
    (out (. b x)) (out "\n")
    (out (+ (. a x) (. b y))) (out "\n")))
