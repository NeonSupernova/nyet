;;;; arith_widths.no

;;; Arithmetic (+ - * / %) must emit at the operands' own width, not
;;; assume i32 -- mirrors cmp_widths.no but for _emit_arith, which used
;;; to hardcode `add i32`/`sub i32`/etc. regardless of operand type.
;;; Also exercises `out` on an i64 value, which used to hardcode the
;;; `%d`/i32 printf call and truncate wide values.

(fn main () -> unit
  (do
    ;; i64 arithmetic that overflows i32 if truncated.
    (let x:i64 5000000000i64)
    (let y:i64 3i64)
    (out (+ x y)) (out "\n")
    (out (- x y)) (out "\n")
    (out (* y 2i64)) (out "\n")

    ;; i64 var mutated in a loop via `(+ i 1)` -- the exact pattern that
    ;; exposed the original bug (accumulator truncated to i32 mid-loop).
    (var acc:i64 0)
    (var i:i64 0)
    (loop
      (if (>= i 5) (break pass) pass)
      (= acc (+ acc 1))
      (= i (+ i 1)))
    (out acc) (out "\n")

    ;; i64 operand paired with a bare int literal (literal yields to i64).
    (out (+ x 1)) (out "\n")))
