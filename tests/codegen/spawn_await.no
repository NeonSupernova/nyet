;;;; spawn_await.no

;;; `spawn`/`await`: runs a top-level function on a real OS thread
;;; (runtime/async.c's nyet_spawn) and joins it (nyet_await). Scoped to
;;; functions with exactly one ptr-typed param and ptr-typed return --
;;; that shape matches pthread's start-routine signature exactly, so no
;;; trampoline is needed. Covers both a string-returning function and a
;;; struct-returning one. Output order is deterministic since every
;;; `await` blocks until its thread finishes before any `out` runs.

(struct Squared val:i32)

(fn greet (name:string) -> string
  (+ "hello, " name))

(fn square (n:Squared) -> Squared
  (Squared val:(* (. n val) (. n val))))

(fn main () -> unit
  (do
    (let h1 (spawn (greet "world")))
    (let h2 (spawn (square (Squared val:7))))
    (let g:string (await h1))
    (let s:Squared (await h2))
    (out! g) (out! "\n")
    (out! (. s val)) (out! "\n")))
