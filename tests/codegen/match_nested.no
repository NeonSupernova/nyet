;; Nested variant pattern: (Some (Some x)).
;; Expected:
;;   inner = 42
;;   inner = none
;;   outer = none

(type Option[T]
  (Some T)
  (None))

(fn describe (o:Option[Option[i32]]) -> unit
  (match o
    ((Some (Some x)) (do (out! "inner = ") (out! x) (out! "\n")))
    ((Some (None)) (out! "inner = none\n"))
    ((None) (out! "outer = none\n"))))

(fn main () -> unit
  (describe (Some (Some 42)))
  (describe (Some (None)))
  (describe (None)))
