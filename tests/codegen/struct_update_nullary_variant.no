;; Regression test: struct update syntax, bare nullary variants used as
;; values, and a receiver's own method shadowing a builtin of the same name.
;;
;; Before the fix:
;;   - `(Person ..me age:37)` reached codegen as a constructor call with a
;;     literal `..` identifier argument and crashed.
;;   - `(Bad DivisionByZero)` crashed: a nullary variant name used as a value
;;     (rather than called, `(DivisionByZero)`) had no codegen at all.
;;   - `(len &s)` on a struct with its own `len` method compiled the builtin
;;     array `len` against the struct pointer.
;;
;; Expected:
;;   Ada 37 London
;;   div by zero
;;   len 5
;;   2.5

(struct Address city:string)
(struct Person name:string age:i32 address:Address)

(type MathError (DivisionByZero) (Overflow))
(type Outcome (Good f64) (Bad MathError))

(fn divide (a:f64 b:f64) -> Outcome
  (if (== b 0.0) (Bad DivisionByZero) (Good (/ a b))))

(struct Stack items:Array[i32] size:i32)

(impl Stack
  (fn len (self:&Stack) -> i32 (. self size)))

(fn main () -> unit
  (do
    (let me (Person name:"Ada" age:36 address:(Address city:"London")))
    (let older (Person ..me age:37))
    (out (fmt "{} {} {}\n" (. older name) (. older age) (. older address city)))

    (match (divide 1.0 0.0)
      ((Good v) (out (fmt "{}\n" v)))
      ((Bad Overflow) (out "overflow\n"))
      ((Bad DivisionByZero) (out "div by zero\n")))

    (let s (Stack items:[1 2 3] size:5))
    (out (fmt "len {}\n" (len &s)))

    (match (divide 5.0 2.0)
      ((Good v) (out (fmt "{}\n" v)))
      ((Bad _) (out "bad\n")))))
