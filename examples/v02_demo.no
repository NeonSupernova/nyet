;; v0.2 demo: exercises the full v0.2 subset.
;; Demonstrates structs, field access, float arithmetic,
;; sum types, match expressions, struct params in functions.
;;
;; Expected output:
;;   hello, world
;;   42
;;   7
;;   positive
;;   10
;;   done
;;   --- v0.2 ---
;;   3
;;   4
;;   7.5
;;   circle area: 78.5397
;;   rect area: 24
;;   triangle area: 6
;;   Circle has area 78.5397
;;   Rect has area 24
;;   Tri has area 6

;; ---- v0.1 features still work ----

(struct Point x:i32 y:i32)
(struct Circle radius:f64)
(struct Rect width:f64 height:f64)
(struct Triangle base:f64 height:f64)

(type Shape
  (CircleS f64)
  (RectS f64 f64)
  (TriS f64 f64))

(fn sum_point (p:Point) -> i32
  (+ (. p x) (. p y)))

(fn circle_area (c:Circle) -> f64
  (* 3.14159 (* (. c radius) (. c radius))))

(fn rect_area (r:Rect) -> f64
  (* (. r width) (. r height)))

(fn tri_area (t:Triangle) -> f64
  (* 0.5 (* (. t base) (. t height))))

(fn shape_area (s:Shape) -> f64
  (match s
    ((CircleS r) (* 3.14159 (* r r)))
    ((RectS w h) (* w h))
    ((TriS b h) (* 0.5 (* b h)))))

(fn main () -> unit
  ;; v0.1 features
  (out! "hello, world\n")

  (let x:i32 42)
  (out! x)
  (out! "\n")

  (let sum:i32 (+ 3 4))
  (out! sum)
  (out! "\n")

  (let n:i32 5)
  (let label:string
    (if (> n 0) "positive" "negative"))
  (out! label)
  (out! "\n")

  (var count:i32 0)
  (= count 10)
  (out! count)
  (out! "\n")

  (out! "done\n")

  ;; v0.2 features
  (out! "--- v0.2 ---\n")

  ;; Struct construction + field access
  (let p:Point (Point 3 4))
  (out! (. p x))
  (out! "\n")
  (out! (. p y))
  (out! "\n")

  ;; Float arithmetic
  (let a:f64 3.0)
  (let b:f64 4.5)
  (out! (+ a b))
  (out! "\n")

  ;; Struct functions
  (let c:Circle (Circle 5.0))
  (out! "circle area: ")
  (out! (circle_area c))
  (out! "\n")

  (let r:Rect (Rect 4.0 6.0))
  (out! "rect area: ")
  (out! (rect_area r))
  (out! "\n")

  (let t:Triangle (Triangle 4.0 3.0))
  (out! "triangle area: ")
  (out! (tri_area t))
  (out! "\n")

  ;; Sum type + match
  (let s1:Shape (CircleS 5.0))
  (out! "Circle has area ")
  (out! (shape_area s1))
  (out! "\n")

  (let s2:Shape (RectS 4.0 6.0))
  (out! "Rect has area ")
  (out! (shape_area s2))
  (out! "\n")

  (let s3:Shape (TriS 4.0 3.0))
  (out! "Tri has area ")
  (out! (shape_area s3))
  (out! "\n"))
