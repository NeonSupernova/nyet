;; Demo: variadic macros and quote-based source capture.
;;
;; `do_all` is in the prelude — it splices any number of forms into a `do`.
;; `show` uses (quote x) to print the source form of its argument alongside
;; its evaluated value.

(macro show (x)
  (do
    (out! (quote x))
    (out! " = ")
    (out! x)
    (out! "\n")))

(fn main () -> unit
  (do_all!
    (show! 42)
    (show! (+ 42 2))
    (out! "all done\n")))
