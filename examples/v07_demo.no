;; v0.7 demo: nested patterns, guards, exhaustiveness.
;;
;; Highlights:
;;   - Nested variant patterns: `(Some (Some x))` peels two layers.
;;   - Guards (`when`): an arm only fires if its predicate also passes.
;;   - Literal patterns nested in payloads: `(Pos 0)` matches a specific value.
;;
;; Expected output:
;;   double some 21 -> 42
;;   double some 0 -> zero!
;;   double some none -> outer some, inner none
;;   double none -> outer none
;;   classify 0 -> zero
;;   classify 5 -> small positive: 5
;;   classify 50 -> big positive: 50
;;   classify 7 (neg) -> negative: 7

(type Option[T]
  (Some T)
  (None))

(type Sign
  (Pos i32)
  (Neg i32))

;; Nested destructuring: peel both Options at once.
(fn double_inner (o:Option[Option[i32]]) -> unit
  (match o
    ((Some (Some 0)) (out "double some 0 -> zero!\n"))
    ((Some (Some n))
      (do (out "double some ") (out n) (out " -> ")
          (out (* n 2)) (out "\n")))
    ((Some (None))
      (out "double some none -> outer some, inner none\n"))
    ((None)
      (out "double none -> outer none\n"))))

;; Guards select among arms with the same shape.
(fn classify (s:Sign) -> unit
  (match s
    ((Pos n) when (== n 0)
      (do (out "classify 0 -> zero\n")))
    ((Pos n) when (< n 10)
      (do (out "classify ") (out n) (out " -> small positive: ")
          (out n) (out "\n")))
    ((Pos n)
      (do (out "classify ") (out n) (out " -> big positive: ")
          (out n) (out "\n")))
    ((Neg n)
      (do (out "classify ") (out n) (out " (neg) -> negative: ")
          (out n) (out "\n")))))

(fn main () -> unit
  (double_inner (Some (Some 21)))
  (double_inner (Some (Some 0)))
  (double_inner (Some (None)))
  (double_inner (None))

  (classify (Pos 0))
  (classify (Pos 5))
  (classify (Pos 50))
  (classify (Neg 7)))
