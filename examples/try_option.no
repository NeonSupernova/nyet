;; Test `?` operator on Option[T].
;; Expected output:
;;   double some: 20
;;   double none: early returned None
;;   done

(type Option[T]
  (Some T)
  (None))

(fn double_it (o:Option[i32]) -> Option[i32]
  (Some (* 2 (? o))))

(fn describe (o:Option[i32]) -> unit
  (match o
    ((Some n) (do (out n) (out "\n")))
    ((None) (out "none\n"))))

(fn main () -> unit
  (let a:Option[i32] (Some 10))
  (out "double some: ")
  (describe (double_it a))

  (let b:Option[i32] (None))
  (out "double none: early returned ")
  (describe (double_it b))
  (out "done\n"))
