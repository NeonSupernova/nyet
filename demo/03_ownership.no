;; Demo 3: move semantics + the borrow checker (the good path).
;;
;; `Person` holds a `string`, so it isn't implicitly copyable -- passing
;; one by value *moves* it. Here every call takes `&Person` (a borrow)
;; instead, so `alice` and `bob` stay usable for the rest of `main`.
;;
;; Try the companion file next to see the checker reject a mistake:
;;   nyet check demo\03_ownership_bad.no
;;
;; Expected output:
;;   alice is 30
;;   bob is 25
;;   alice is 30
;;   total ages = 55

(struct Person name:string age:i32)

(fn show (p:&Person) -> unit
  (out (. p name)) (out " is ") (out (. p age)) (out "\n"))

(fn age_of (p:&Person) -> i32
  (. p age))

(fn main () -> unit
  (let alice (Person name:"alice" age:30))
  (let bob (Person name:"bob" age:25))

  (show &alice)
  (show &bob)
  (show &alice)  ;; borrowing again is fine -- nothing was moved

  (let total (+ (age_of &alice) (age_of &bob)))
  (out "total ages = ") (out total) (out "\n"))
