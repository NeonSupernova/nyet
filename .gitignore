*.no

# `.no` is ignored by default so scratch programs in the working tree
# don't get committed by accident; everything the repo actually keeps is
# listed back in here.

# The language reference and the standard library -- the `.no` source
# that ships with the compiler.
!/main.no
!std/**/*.no

# Test fixtures.
!/tests/**/*.no

# Examples: short self-contained programs (one feature each), the
# guided tour/ set that goes into the Windows bundle's demo\ folder,
# and interactive/ for the ones that read stdin.
!examples/**/*.no

# The arcade demo suite: five games plus a launcher that links all five
# into one binary via `(use ...)`. Each game directory holds a two-line
# main.no wrapper around a shared module in demos/lib/.
!demos/**/*.no

*.pyc
__pycache__

output*
.idea/
node_modules/
.coverage
.mypy_cache/
.ruff_cache/
htmlcov/
*.vsix
build/
*.o
packaging/dist/