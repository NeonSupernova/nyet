<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Nyet</string>
    <key>scopeName</key>
    <string>source.nyet</string>
    <key>fileTypes</key>
    <array>
        <string>no</string>
    </array>
    <key>uuid</key>
    <string>A1C2E3F4-B5D6-7890-ABCD-EF1234567890</string>
    <key>patterns</key>
    <array>
        <dict><key>include</key><string>#comment</string></dict>
        <dict><key>include</key><string>#string</string></dict>
        <dict><key>include</key><string>#number</string></dict>
        <dict><key>include</key><string>#constant</string></dict>
        <dict><key>include</key><string>#fn-definition</string></dict>
        <dict><key>include</key><string>#type-definition</string></dict>
        <dict><key>include</key><string>#impl-definition</string></dict>
        <dict><key>include</key><string>#control-keyword</string></dict>
        <dict><key>include</key><string>#decl-keyword</string></dict>
        <dict><key>include</key><string>#module-keyword</string></dict>
        <dict><key>include</key><string>#other-keyword</string></dict>
        <dict><key>include</key><string>#builtin-function</string></dict>
        <dict><key>include</key><string>#generic-type</string></dict>
        <dict><key>include</key><string>#primitive-type</string></dict>
        <dict><key>include</key><string>#operator</string></dict>
        <dict><key>include</key><string>#type-annotation</string></dict>
        <dict><key>include</key><string>#keyword-literal</string></dict>
        <dict><key>include</key><string>#punctuation</string></dict>
    </array>
    <key>repository</key>
    <dict>

        <key>comment</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>comment.block.nyet</string>
                    <key>begin</key><string>#\|</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.definition.comment.begin.nyet</string></dict>
                    </dict>
                    <key>end</key><string>\|#</string>
                    <key>endCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.definition.comment.end.nyet</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>name</key><string>comment.line.section.nyet</string>
                    <key>match</key><string>;;;+.*$</string>
                </dict>
                <dict>
                    <key>name</key><string>comment.line.block.nyet</string>
                    <key>match</key><string>;;.*$</string>
                </dict>
                <dict>
                    <key>name</key><string>comment.line.semicolon.nyet</string>
                    <key>match</key><string>;.*$</string>
                </dict>
            </array>
        </dict>

        <key>string</key>
        <dict>
            <key>name</key><string>string.quoted.double.nyet</string>
            <key>begin</key><string>"</string>
            <key>end</key><string>"</string>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>constant.character.escape.nyet</string>
                    <key>match</key><string>\\(?:[\\\"ntr0]|x[0-9a-fA-F]{2})</string>
                </dict>
                <dict>
                    <key>name</key><string>invalid.illegal.escape.nyet</string>
                    <key>match</key><string>\\.</string>
                </dict>
            </array>
        </dict>

        <key>number</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>constant.numeric.integer.hexadecimal.nyet</string>
                    <key>match</key><string>\b0x[0-9a-fA-F][0-9a-fA-F_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize)?\b</string>
                </dict>
                <dict>
                    <key>name</key><string>constant.numeric.integer.binary.nyet</string>
                    <key>match</key><string>\b0b[01][01_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize)?\b</string>
                </dict>
                <dict>
                    <key>name</key><string>constant.numeric.integer.octal.nyet</string>
                    <key>match</key><string>\b0o[0-7][0-7_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize)?\b</string>
                </dict>
                <dict>
                    <key>name</key><string>constant.numeric.float.nyet</string>
                    <key>match</key><string>\b[0-9][0-9_]*\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?(?:f32|f64)?\b</string>
                </dict>
                <dict>
                    <key>name</key><string>constant.numeric.integer.decimal.nyet</string>
                    <key>match</key><string>\b[0-9][0-9_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize)?\b</string>
                </dict>
            </array>
        </dict>

        <key>constant</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>constant.language.boolean.true.nyet</string>
                    <key>match</key><string>\btrue\b</string>
                </dict>
                <dict>
                    <key>name</key><string>constant.language.boolean.false.nyet</string>
                    <key>match</key><string>\bfalse\b</string>
                </dict>
            </array>
        </dict>

        <key>fn-definition</key>
        <dict>
            <key>match</key><string>\(\s*(fn!?)\s+([a-zA-Z_][a-zA-Z0-9_/]*[!?]?)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>keyword.declaration.function.nyet</string></dict>
                <key>2</key><dict><key>name</key><string>entity.name.function.nyet</string></dict>
            </dict>
        </dict>

        <key>type-definition</key>
        <dict>
            <key>match</key><string>\(\s*(struct|type|newtype|alias|trait)\s+([A-Z][a-zA-Z0-9_]*(?:\[[^\]]*\])?)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>keyword.declaration.type.nyet</string></dict>
                <key>2</key><dict><key>name</key><string>entity.name.type.nyet</string></dict>
            </dict>
        </dict>

        <key>impl-definition</key>
        <dict>
            <key>match</key><string>\(\s*(impl)\s+([A-Z][a-zA-Z0-9_]*)\s+([A-Z][a-zA-Z0-9_]*(?:\[[^\]]*\])?)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>keyword.declaration.impl.nyet</string></dict>
                <key>2</key><dict><key>name</key><string>entity.name.type.trait.nyet</string></dict>
                <key>3</key><dict><key>name</key><string>entity.name.type.nyet</string></dict>
            </dict>
        </dict>

        <key>control-keyword</key>
        <dict>
            <key>name</key><string>keyword.control.nyet</string>
            <key>match</key><string>(?&lt;=\()\s*(if|match|when|loop|break|return|do)(?=[\s)])</string>
        </dict>

        <key>decl-keyword</key>
        <dict>
            <key>name</key><string>keyword.declaration.variable.nyet</string>
            <key>match</key><string>(?&lt;=\()\s*(let|var|const)(?=[\s)])</string>
        </dict>

        <key>module-keyword</key>
        <dict>
            <key>name</key><string>keyword.other.module.nyet</string>
            <key>match</key><string>(?&lt;=\()\s*(pub|use|module|macro|quote)(?=[\s)])</string>
        </dict>

        <key>other-keyword</key>
        <dict>
            <key>name</key><string>keyword.other.nyet</string>
            <key>match</key><string>\b(self|Self|dyn|move|async|await|spawn|pass)\b</string>
        </dict>

        <key>builtin-function</key>
        <dict>
            <key>name</key><string>support.function.builtin.nyet</string>
            <key>match</key><string>(?&lt;=\()\s*(out|err|in|fmt|str|len|push|pop|append|parse|gensym|type)(?=[\s)])</string>
        </dict>

        <key>generic-type</key>
        <dict>
            <key>match</key><string>\b(Option|Result|Array)(?=\[)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>support.class.builtin.nyet</string></dict>
            </dict>
        </dict>

        <key>primitive-type</key>
        <dict>
            <key>name</key><string>storage.type.nyet</string>
            <key>match</key><string>\b(i8|i16|i32|i64|u8|u16|u32|u64|usize|f32|f64|bool|string|unit)\b</string>
        </dict>

        <key>operator</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>keyword.operator.arrow.nyet</string>
                    <key>match</key><string>-&gt;</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.pipe.nyet</string>
                    <key>match</key><string>\|&gt;</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.spread.nyet</string>
                    <key>match</key><string>\.\.</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.try.nyet</string>
                    <key>match</key><string>\?</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.comparison.nyet</string>
                    <key>match</key><string>==|!=|&lt;=|&gt;=|&lt;|&gt;</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.logical.nyet</string>
                    <key>match</key><string>&amp;&amp;|\|\|</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.bitwise.nyet</string>
                    <key>match</key><string>&lt;&lt;|&gt;&gt;|&amp;!|&amp;|\^|~</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.arithmetic.nyet</string>
                    <key>match</key><string>[+\-*/%]</string>
                </dict>
                <dict>
                    <key>name</key><string>keyword.operator.assignment.nyet</string>
                    <key>match</key><string>(?&lt;=\()\s*=</string>
                </dict>
            </array>
        </dict>

        <key>type-annotation</key>
        <dict>
            <key>match</key><string>([a-zA-Z_][a-zA-Z0-9_]*[!?]?)(:)(&amp;!?)?([a-zA-Z_][a-zA-Z0-9_]*(?:\[[^\]]*\])?)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>variable.parameter.nyet</string></dict>
                <key>2</key><dict><key>name</key><string>punctuation.separator.type-annotation.nyet</string></dict>
                <key>3</key><dict><key>name</key><string>keyword.operator.borrow.nyet</string></dict>
                <key>4</key><dict><key>name</key><string>storage.type.nyet</string></dict>
            </dict>
        </dict>

        <key>keyword-literal</key>
        <dict>
            <key>name</key><string>constant.other.symbol.nyet</string>
            <key>match</key><string>:[a-zA-Z_][a-zA-Z0-9_]*[!?]?</string>
        </dict>

        <key>punctuation</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>punctuation.definition.tuple.begin.nyet</string>
                    <key>match</key><string>#\(</string>
                </dict>
                <dict>
                    <key>name</key><string>punctuation.section.parens.begin.nyet</string>
                    <key>match</key><string>\(</string>
                </dict>
                <dict>
                    <key>name</key><string>punctuation.section.parens.end.nyet</string>
                    <key>match</key><string>\)</string>
                </dict>
                <dict>
                    <key>name</key><string>punctuation.section.brackets.begin.nyet</string>
                    <key>match</key><string>\[</string>
                </dict>
                <dict>
                    <key>name</key><string>punctuation.section.brackets.end.nyet</string>
                    <key>match</key><string>\]</string>
                </dict>
                <dict>
                    <key>name</key><string>punctuation.section.braces.begin.nyet</string>
                    <key>match</key><string>\{</string>
                </dict>
                <dict>
                    <key>name</key><string>punctuation.section.braces.end.nyet</string>
                    <key>match</key><string>\}</string>
                </dict>
            </array>
        </dict>

    </dict>
</dict>
</plist>
